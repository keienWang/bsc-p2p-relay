+func identityFixture() (*PackageGraph, *packages.Package, *packages.Package) {
+ m := &packages.Module{Path: "example.org/m", Version: "v1.0.0"}
+ a := &packages.Package{ID:"example.org/m/p", PkgPath:"example.org/m/p", Module:m, Types:types.NewPackage("example.org/m/p","p")}
+ b := &packages.Package{ID:"example.org/m/p [example.org/m/p.test]", PkgPath:a.PkgPath, Module:m, Types:types.NewPackage(a.PkgPath,"p")}
+ g := &PackageGraph{packages:map[string]*packages.Package{}, modules:map[string]*packages.Module{}, topPkgs:[]*packages.Package{a,b}}
+ g.AddPackages(a,b)
+ return g,a,b
+}
+
+func TestSourceTypesAndImportedFindingsKeepVariant(t *testing.T) {
+ g,a,b := identityFixture()
+ if err:=g.prepareSourceIdentity(true); err!=nil {t.Fatal(err)}
+ if g.sourceIdentity.byTypes[a.Types]!=a || g.sourceIdentity.byTypes[b.Types]!=b {t.Fatal("types identity collapsed")}
+ osvEntry := &osv.Entry{ID:"TEST-VARIANTS",Affected:[]osv.Affected{{
+  Module:osv.Module{Path:a.Module.Path},
+  EcosystemSpecific:osv.EcosystemSpecific{Packages:[]osv.Package{{Path:a.PkgPath,Symbols:[]string{"F"}}}},
+ }}}
+ aff := affectingVulns{&ModVulns{Module:a.Module,Vulns:[]*osv.Entry{osvEntry}}}
+ findings := importedVulnPackages(aff,g)
+ seen:=map[*packages.Package]bool{}
+ for _,v:=range findings {seen[v.Package]=true}
+ if len(findings)!=2 || !seen[a] || !seen[b] {t.Fatal("import findings lost actual source package")}
+ prog:=ssa.NewProgram(token.NewFileSet(),ssa.InstantiateGenerics)
+ sp:=prog.CreatePackage(b.Types,nil,nil,true)
+ f:=prog.NewFunction("F",types.NewSignatureType(nil,nil,nil,nil,nil,false),"test function")
+ f.Pkg=sp
+ owner,err:=g.sourceFunctionOwner(f)
+ if err!=nil || owner!=b {t.Fatalf("owner=%p error=%v, want variant",owner,err)}
+ cg:=callgraph.New(f)
+ if err:=g.indexSourceFunctions(cg,[]*ssa.Function{f});err!=nil {t.Fatal(err)}
+ sinks,err:=vulnFuncs(cg,aff,g)
+ if err!=nil || len(sinks)!=1 {t.Fatalf("symbol lookup sinks=%d err=%v",len(sinks),err)}
+ frame,err:=createNode(map[*ssa.Function]*FuncNode{},f,g)
+ if err!=nil || frame.Package!=b {t.Fatalf("frame owner lost variant: %v",err)}
+ // Same path, different unregistered types object must NOT fall back to a.
+ outsider:=prog.CreatePackage(types.NewPackage(a.PkgPath,"p"),nil,nil,true)
+ f.Pkg=outsider
+ if _,err:=g.sourceFunctionOwner(f);err==nil {t.Fatal("same-path fallback accepted")}
+ if _,err:=vulnFuncs(cg,aff,g);err==nil {t.Fatal("symbol lookup accepted missing identity")}
+ if _,err:=createNode(map[*ssa.Function]*FuncNode{},f,g);err==nil {t.Fatal("frame creation accepted missing identity")}
+ if err:=g.indexSourceFunctions(cg,[]*ssa.Function{f});err==nil {t.Fatal("callgraph validation accepted missing identity")}
+ f.Pkg=nil
+ owner,err=g.sourceFunctionOwner(f)
+ if err!=nil || owner.PkgPath!=internal.UnknownPackagePath {t.Fatal("explicit synthetic unknown rejected")}
+ f.Synthetic=""
+ if _,err:=g.sourceFunctionOwner(f);err==nil {t.Fatal("non-synthetic missing owner accepted")}
+}
+
+func TestSourceIdentityConflictsFailClosed(t *testing.T) {
+ cases:=[]struct{name string; mutate func(*packages.Package,*packages.Package)}{
+  {"version",func(a,b *packages.Package){b.Module=&packages.Module{Path:a.Module.Path,Version:"v2.0.0"}}},
+  {"directory",func(a,b *packages.Package){b.Module=&packages.Module{Path:a.Module.Path,Version:a.Module.Version,Dir:"different"}}},
+  {"replacement",func(a,b *packages.Package){b.Module=&packages.Module{Path:a.Module.Path,Version:a.Module.Version,Replace:&packages.Module{Path:"example.org/fork",Version:"v1.0.0"}}}},
+  {"shared types",func(a,b *packages.Package){b.Types=a.Types}},
+  {"missing types",func(a,b *packages.Package){b.Types=nil}},
+ }
+ for _,tc:=range cases {t.Run(tc.name,func(t *testing.T){
+  g,a,b:=identityFixture();tc.mutate(a,b)
+  if err:=g.prepareSourceIdentity(true);err==nil {t.Fatal("conflict accepted")}
+  if g.sourceIdentity!=nil {t.Fatal("partial index published after error")}
+  // A nil client is deliberate: validation must fail before any fetch.
+  result,err:=source(context.Background(),test.NewMockHandler(),&govulncheck.Config{ScanLevel:"symbol"},nil,g)
+  if result!=nil || err==nil {t.Fatal("source did not reject conflict before scan")}
+ })}
+}
