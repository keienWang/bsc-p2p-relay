+func TestSourceSamePathReplacementAndEffectiveConflict(t *testing.T) {
+ g,a,b:=identityFixture()
+ m:=&packages.Module{Path:a.Module.Path,Version:"v1.0.0",Replace:&packages.Module{Path:a.Module.Path,Version:"v1.1.0"}}
+ a.Module=m;b.Module=m;g.modules[m.Path]=m
+ if err:=g.prepareSourceIdentity(true);err!=nil {t.Fatalf("valid same-path replacement: %v",err)}
+ c:=&packages.Package{ID:"example.org/alias/q",PkgPath:"example.org/alias/q",Types:types.NewPackage("example.org/alias/q","q"),
+  Module:&packages.Module{Path:"example.org/alias",Version:"v1.0.0",Replace:&packages.Module{Path:m.Path,Version:"v9.0.0"}}}
+ g.topPkgs=append(g.topPkgs,c);g.AddPackages(c)
+ if err:=g.prepareSourceIdentity(true);err==nil {t.Fatal("conflicting effective version accepted")}
+}
