+// Copyright 2026 The bsc-p2p-relay contributors.
+// SPDX-License-Identifier: BSD-3-Clause
+package vulncheck
+
+import (
+ "fmt"
+ "go/types"
+
+ "golang.org/x/tools/go/callgraph"
+ "golang.org/x/tools/go/packages"
+ "golang.org/x/tools/go/ssa"
+ "golang.org/x/vuln/internal"
+)
+
+// Source-only identity checks. Binary callers keep their existing path API.
+// Never infer a source owner from a same-path representative.
+type sourceIdentity struct {
+ byTypes map[*types.Package]*packages.Package
+ unknown *packages.Package
+}
+
+type sourceModuleKey struct { path, version, dir string }
+type sourceModuleIdentity struct {
+ original sourceModuleKey
+ replacement sourceModuleKey
+ replaced bool
+}
+
+func sourceModuleID(m *packages.Module) (sourceModuleIdentity, error) {
+ if m == nil || m.Path == "" { return sourceModuleIdentity{}, fmt.Errorf("source package has no module identity") }
+ id := sourceModuleIdentity{original: sourceModuleKey{m.Path, m.Version, m.Dir}}
+ if m.Replace != nil {
+  if m.Replace.Path == "" || m.Replace.Replace != nil {
+   return sourceModuleIdentity{}, fmt.Errorf("unsupported replacement identity for %q", m.Path)
+  }
+  id.replaced = true
+  id.replacement = sourceModuleKey{m.Replace.Path, m.Replace.Version, m.Replace.Dir}
+ }
+ return id, nil
+}
+
+// prepareSourceIdentity rejects conflicting original OR effective identities
+// before emitting an SBOM or findings. Replacement roles use separate maps:
+// a legitimate same-path version replacement is not itself a conflict.
+func (g *PackageGraph) prepareSourceIdentity(symbols bool) error {
+ g.sourceIdentity = nil
+ index := &sourceIdentity{
+  byTypes: make(map[*types.Package]*packages.Package),
+  unknown: &packages.Package{PkgPath: internal.UnknownPackagePath,
+   Module: &packages.Module{Path: internal.UnknownModulePath}},
+ }
+ originals := make(map[string]sourceModuleIdentity)
+ effective := make(map[string]sourceModuleKey)
+ visited := make(map[*packages.Package]bool)
+ var visit func(*packages.Package) error
+ visit = func(p *packages.Package) error {
+  if p == nil { return fmt.Errorf("nil source package in loaded graph") }
+  if visited[p] { return nil }
+  visited[p] = true
+  id, err := sourceModuleID(p.Module)
+  if err != nil { return fmt.Errorf("package %q: %w", p.ID, err) }
+  if prior, ok := originals[id.original.path]; ok && prior != id {
+   return fmt.Errorf("conflicting source module identity for %q", id.original.path)
+  }
+  originals[id.original.path] = id
+  eff := id.original
+  if id.replaced { eff = id.replacement }
+  if prior, ok := effective[eff.path]; ok && prior != eff {
+   return fmt.Errorf("conflicting effective module identity for %q", eff.path)
+  }
+  effective[eff.path] = eff
+  // AddModules keeps the first representative. Ensure it agrees with the
+  // package's original identity, not merely that its path was registered.
+  registered, ok := g.modules[id.original.path]
+  if !ok { return fmt.Errorf("unregistered source module %q", id.original.path) }
+  registeredID, err := sourceModuleID(registered)
+  if err != nil || registeredID != id {
+   return fmt.Errorf("source module registry disagrees for %q", id.original.path)
+  }
+  if symbols && p.Types == nil { return fmt.Errorf("package %q has no types identity", p.ID) }
+  if p.Types != nil {
+   if p.Types.Path() != p.PkgPath { return fmt.Errorf("types path mismatch for %q", p.ID) }
+   if old, ok := index.byTypes[p.Types]; ok && old != p {
+    return fmt.Errorf("types identity shared by distinct source packages %q and %q", old.ID, p.ID)
+   }
+   index.byTypes[p.Types] = p
+  }
+  for _, child := range p.Imports { if err := visit(child); err != nil { return err } }
+  return nil
+ }
+ if len(g.topPkgs) == 0 { return fmt.Errorf("empty source roots") }
+ for _, p := range g.topPkgs { if err := visit(p); err != nil { return err } }
+ g.sourceIdentity = index
+ return nil
+}
+
+func (g *PackageGraph) sourceFunctionOwner(f *ssa.Function) (*packages.Package, error) {
+ if g.sourceIdentity == nil { return nil, fmt.Errorf("source identity has not been validated") }
+ if f == nil { return nil, fmt.Errorf("nil SSA function has no source owner") }
+ owner := f
+ if origin := f.Origin(); origin != nil { owner = origin }
+ var typ *types.Package
+ if sp := owner.Package(); sp != nil { typ = sp.Pkg }
+ if typ == nil && owner.Object() != nil { typ = owner.Object().Pkg() }
+ if typ != nil {
+  p, ok := g.sourceIdentity.byTypes[typ]
+  if !ok { return nil, fmt.Errorf("unregistered SSA types identity for %q", typ.Path()) }
+  return p, nil
+ }
+ if parent := owner.Parent(); parent != nil { return g.sourceFunctionOwner(parent) }
+ // Only explicitly synthetic functions with no package, object owner, or
+ // lexical parent may be unknown. No path-string fallback is allowed.
+ if owner.Synthetic != "" { return g.sourceIdentity.unknown, nil }
+ return nil, fmt.Errorf("non-synthetic SSA function %q has no package identity", owner.Name())
+}
+
+// Validate every callgraph node and edge plus all entry functions before any
+// symbol finding is built. Emission helpers also check ownership directly.
+func (g *PackageGraph) indexSourceFunctions(cg *callgraph.Graph, entries []*ssa.Function) error {
+ if cg == nil { return fmt.Errorf("nil source callgraph") }
+ if g.sourceIdentity == nil { return fmt.Errorf("source identity has not been validated") }
+ owners := make(map[*ssa.Function]*packages.Package)
+ add := func(f *ssa.Function) error {
+  if _, ok := owners[f]; ok { return nil }
+  p, err := g.sourceFunctionOwner(f)
+  if err != nil { return err }
+  owners[f] = p
+  return nil
+ }
+ for f, n := range cg.Nodes {
+  if n == nil || n.Func != f { return fmt.Errorf("inconsistent source callgraph node") }
+  if err := add(f); err != nil { return err }
+  for _, edges := range [][]*callgraph.Edge{n.In, n.Out} {
+   for _, e := range edges {
+    if e == nil || e.Caller == nil || e.Callee == nil { return fmt.Errorf("invalid source callgraph edge") }
+    if err := add(e.Caller.Func); err != nil { return err }
+    if err := add(e.Callee.Func); err != nil { return err }
+   }
+  }
+ }
+ for _, f := range entries { if err := add(f); err != nil { return err } }
+ return nil
+}
