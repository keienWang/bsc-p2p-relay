+func TestSourceGenericOriginIdentity(t *testing.T) {
+ e:=packagestest.Export(t,packagestest.Modules,[]packagestest.Module{{
+  Name:"example.org/generic",Files:map[string]interface{}{
+   "p/p.go":"package p\nfunc Generic[T any](v T) T { return v }\nfunc Entry() { _ = Generic(1) }\n",
+  },
+ }})
+ defer e.Cleanup()
+ g:=NewPackageGraph("go1.26.11")
+ if err:=g.LoadPackagesAndMods(e.Config,nil,[]string{path.Join(e.Temp(),"generic/p")},true);err!=nil {t.Fatal(err)}
+ if err:=g.prepareSourceIdentity(true);err!=nil {t.Fatal(err)}
+ prog,_:=buildSSA(g.TopPkgs(),g.TopPkgs()[0].Fset)
+ found:=false
+ for f:=range ssautil.AllFunctions(prog) {
+  if f.Origin()==nil {continue}
+  found=true
+  p,err:=g.sourceFunctionOwner(f)
+  if err!=nil || p!=g.TopPkgs()[0] {t.Fatalf("generic owner=%p err=%v",p,err)}
+  delete(g.sourceIdentity.byTypes,f.Origin().Package().Pkg)
+  if _,err:=g.sourceFunctionOwner(f);err==nil {t.Fatal("unregistered generic origin accepted")}
+  break
+ }
+ if !found {t.Fatal("fixture did not create a generic instance")}
+}
