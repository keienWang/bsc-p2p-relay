+// Copyright 2026 The bsc-p2p-relay contributors.
+// SPDX-License-Identifier: BSD-3-Clause
+// This regression is for the experimental derivative, not an upstream test.
+package vulncheck
+
+import (
+	"context"
+	"errors"
+	"path"
+	"testing"
+
+	"golang.org/x/tools/go/packages/packagestest"
+	"golang.org/x/vuln/internal/client"
+	"golang.org/x/vuln/internal/govulncheck"
+	"golang.org/x/vuln/internal/osv"
+	"golang.org/x/vuln/internal/test"
+)
+
+// TestCallgraphCancellationPropagates uses an in-memory synthetic database.
+// The explicit fetch precondition distinguishes a callgraph error from a
+// client/fetch failure. It must reach the imported-vulnerability symbol path.
+func TestCallgraphCancellationPropagates(t *testing.T) {
+	e := packagestest.Export(t, packagestest.Modules, []packagestest.Module{
+		{Name: "golang.org/entry", Files: map[string]interface{}{
+			"x/x.go": "package x\nimport \"golang.org/bmod/bvuln\"\nfunc X() { bvuln.Vuln() }\n",
+		}},
+		{Name: "golang.org/bmod@v0.5.0", Files: map[string]interface{}{
+			"bvuln/bvuln.go": "package bvuln\nfunc Vuln() {}\n",
+		}},
+	})
+	defer e.Cleanup()
+	graph := NewPackageGraph("go1.26.11")
+	if err := graph.LoadPackagesAndMods(e.Config, nil, []string{path.Join(e.Temp(), "entry/x")}, true); err != nil {
+		t.Fatal(err)
+	}
+	c, err := client.NewInMemoryClient([]*osv.Entry{{
+		ID: "TEST-CALLGRAPH-CANCEL",
+		Affected: []osv.Affected{{
+			Module: osv.Module{Path: "golang.org/bmod"},
+			Ranges: []osv.Range{{Type: osv.RangeTypeSemver, Events: []osv.RangeEvent{{Introduced: "0"}}}},
+			EcosystemSpecific: osv.EcosystemSpecific{Packages: []osv.Package{{
+				Path: "golang.org/bmod/bvuln", Symbols: []string{"Vuln"},
+			}}},
+		}},
+	}})
+	if err != nil { t.Fatal(err) }
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	mv, err := FetchVulnerabilities(ctx, c, graph.Modules())
+	if err != nil { t.Fatalf("in-memory fetch precondition: %v", err) }
+	if len(importedVulnPackages(affectingVulnerabilities(mv, "", ""), graph)) == 0 {
+		t.Fatal("fixture must reach the symbol-analysis wait branch")
+	}
+	cfg := &govulncheck.Config{ScanLevel: "symbol"}
+	result, err := source(ctx, test.NewMockHandler(), cfg, c, graph)
+	if result != nil || !errors.Is(err, context.Canceled) {
+		t.Fatalf("source returned result=%v error=%v; want nil, context.Canceled", result, err)
+	}
+	if err := Source(ctx, test.NewMockHandler(), cfg, c, graph); !errors.Is(err, context.Canceled) {
+		t.Fatalf("public Source error=%v; want context.Canceled", err)
+	}
+}
