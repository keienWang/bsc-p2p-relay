+// Copyright 2026 The bsc-p2p-relay contributors.
+// SPDX-License-Identifier: BSD-3-Clause
+package vulncheck
+
+import (
+	"testing"
+	"path"
+	"golang.org/x/tools/go/packages/packagestest"
+
+	"golang.org/x/tools/go/packages"
+)
+
+func TestPackageInstancesRetainTestOnlyImports(t *testing.T) {
+	main := &packages.Module{Path: "example.org/main", Version: "v1.0.0"}
+	extra := &packages.Module{Path: "example.org/extra", Version: "v1.2.0"}
+	normal := &packages.Package{ID: "example.org/main/p", PkgPath: "example.org/main/p", Module: main}
+	dependency := &packages.Package{ID: "example.org/extra/x", PkgPath: "example.org/extra/x", Module: extra}
+	variant := &packages.Package{
+		ID: "example.org/main/p [example.org/main/p.test]", PkgPath: normal.PkgPath,
+		Module: main, Imports: map[string]*packages.Package{dependency.PkgPath: dependency},
+	}
+	g := &PackageGraph{packages: map[string]*packages.Package{}, modules: map[string]*packages.Module{}}
+	g.AddPackages(normal, variant, variant)
+	if len(g.instances) != 3 || g.instances[dependency] == false {
+		t.Fatalf("instance closure = %d, want ordinary, test variant, test-only import", len(g.instances))
+	}
+	if g.modules[extra.Path] != extra {
+		t.Fatal("test-only dependency module missing")
+	}
+	if g.packages[normal.PkgPath] != normal {
+		t.Fatal("path compatibility lookup unexpectedly replaced")
+	}
+	// Deliberately make only the ordinary package a root. The same-path test
+	// variant reached through a separate root must still count as a dependency.
+	wrapper := &packages.Package{ID: "example.org/main/w", PkgPath: "example.org/main/w",
+		Module: main, Imports: map[string]*packages.Package{"p": variant}}
+	g.topPkgs = []*packages.Package{normal, wrapper}
+	g.AddPackages(wrapper)
+	seen := map[*packages.Package]bool{}
+	for _, p := range g.DepPkgs() { seen[p] = true }
+	if len(seen) != 2 || !seen[variant] || !seen[dependency] {
+		t.Fatalf("dependencies lost exact package identity: %v", seen)
+	}
+}
+
+func TestLoadedTestRootsKeepIdentity(t *testing.T) {
+	// The load-level fixture is intentionally separate from pointer-only tests:
+	// a graph built by hand cannot prove LoadPackagesAndMods keeps its roots.
+	e := testRootExport(t)
+	defer e.Cleanup()
+	e.Config.Tests = true
+	g := NewPackageGraph("go1.26.11")
+	if err := g.LoadPackagesAndMods(e.Config, nil, []string{path.Join(e.Temp(), "root/p")}, true); err != nil {
+		t.Fatal(err)
+	}
+	var ordinary, variant *packages.Package
+	for _, p := range g.TopPkgs() {
+		if p.PkgPath != "example.org/root/p" { continue }
+		if p.ID == p.PkgPath { ordinary = p } else { variant = p }
+	}
+	if ordinary == nil || variant == nil || ordinary == variant {
+		t.Fatalf("distinct ordinary/test roots missing: ordinary=%p variant=%p", ordinary, variant)
+	}
+	if variant.Imports["example.org/root/onlytest"] == nil {
+		t.Fatal("test root lost its test-only import")
+	}
+}
+
+func testRootExport(t *testing.T) *packagestest.Exported {
+	return packagestest.Export(t, packagestest.Modules, []packagestest.Module{{
+		Name: "example.org/root",
+		Files: map[string]interface{}{
+			"p/p.go": "package p\nfunc P() {}\n",
+			"p/p_test.go": "package p\nimport (\"testing\"; \"example.org/root/onlytest\")\nfunc TestP(t *testing.T) { onlytest.Target() }\n",
+			"onlytest/t.go": "package onlytest\nfunc Target() {}\n",
+		},
+	}})
+}
