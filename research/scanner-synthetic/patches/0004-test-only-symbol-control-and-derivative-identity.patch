+// Copyright 2026 The bsc-p2p-relay contributors.
+// SPDX-License-Identifier: BSD-3-Clause
+package scan
+
+import (
+ "context"
+ "runtime/debug"
+ "testing"
+
+ "golang.org/x/vuln/internal/client"
+)
+
+func assertDerivativeIdentity(t *testing.T, cfg *config) {
+ t.Helper()
+ if cfg.ScannerName!="bsc-relay-testgraph-experimental" {t.Fatalf("misleading scanner name %q",cfg.ScannerName)}
+ if cfg.ScannerVersion!="v0.1.0-testgraph.4+upstream.e672cbe8fbc8" {t.Fatalf("misleading scanner version %q",cfg.ScannerVersion)}
+}
+
+func TestExperimentalScannerIdentity(t *testing.T) {
+ for _,bi:=range []*debug.BuildInfo{
+  nil,
+  {Path:"golang.org/x/vuln/cmd/govulncheck",Main:debug.Module{Version:"v1.9.0"}},
+  {Path:"golang.org/x/vuln/internal/scan.test",Main:debug.Module{Version:"(devel)"}},
+  {Path:"unrelated/name",Main:debug.Module{Version:"v9.9.9"}},
+ } {
+  cfg:=&config{}
+  if bi!=nil { scannerVersion(cfg,bi) }
+  setDerivativeScannerIdentity(cfg)
+  assertDerivativeIdentity(t,cfg)
+ }
+}
+
+func TestExperimentalPreparedScannerIdentity(t *testing.T) {
+ c,err:=client.NewInMemoryClient(nil)
+ if err!=nil {t.Fatal(err)}
+ // Empty ScanMode deliberately avoids the source-mode go-env subprocess.
+ // The in-memory client avoids all real database access.
+ cfg:=&config{}
+ prepareConfig(context.Background(),cfg,c)
+ assertDerivativeIdentity(t,cfg)
+}
