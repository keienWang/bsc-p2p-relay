+// setDerivativeScannerIdentity overrides reconstructed upstream build metadata.
+// These labels identify an experimental derivative, not a verified scan or an
+// upstream release. Exact source/patch hashes belong to the bundle manifest.
+func setDerivativeScannerIdentity(cfg *config) {
+ cfg.ScannerName = "bsc-relay-testgraph-experimental"
+ cfg.ScannerVersion = "v0.1.0-testgraph.4+upstream.e672cbe8fbc8"
+}
